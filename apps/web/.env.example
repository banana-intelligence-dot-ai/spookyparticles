# Copy to .env.local and fill in. Never commit .env.local.

# Neon Postgres connection string (pooled). Only needed at runtime and for db:migrate.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Signs session cookies. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# Public base URL of this app; OAuth redirect URIs are built from it.
BETTER_AUTH_URL=http://localhost:3000

# GitHub App OAuth credentials (Client ID and a generated client secret on the app's settings page).
# Used by Better Auth for "Continue with GitHub". GitHub Apps ignore OAuth scopes.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App: numeric App ID and the slug from https://github.com/apps/<slug>.
GITHUB_APP_ID=
GITHUB_APP_SLUG=

# GitHub App private key: base64 of the .pem file GitHub downloads, on one line.
# Generate with: base64 -i your-app.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# Google OAuth web client, used for Google sign-in and for each Gmail connection (gmail.readonly).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Vercel REST API integration. Empty disables installation.
VERCEL_INTEGRATION_SLUG=
VERCEL_INTEGRATION_CLIENT_ID=
VERCEL_INTEGRATION_CLIENT_SECRET=

# Sign in with Vercel app. Empty disables its sign-in button and provider.
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=

# Master key for token encryption: 32 bytes, base64. Generate with: openssl rand -base64 32
SP_MASTER_KEY=

# Retired master keys during a rotation, comma-separated base64. Leave empty normally.
SP_MASTER_KEY_PREVIOUS=

# PostHog project key. Leave empty and no analytics load or fire.
NEXT_PUBLIC_POSTHOG_KEY=

# PostHog ingestion host, shared by server and browser clients.
POSTHOG_HOST=https://us.i.posthog.com

# Anthropic API key for the reading pipeline (classify and cheap extract with Haiku 5.5, escalate with Sonnet 5.5).
# Wins over ANTHROPIC_API_KEY from the shell (Next.js never lets .env override a shell variable).
# Models can be overridden: SP_MODEL_CLASSIFY and SP_MODEL_EXTRACT default to claude-haiku-5-5; SP_MODEL_ESCALATE defaults to claude-sonnet-5-5.
# SP_READ_AUTO_LIMIT (default 1500): inboxes with more unread billing emails wait for Sync or an explicit Read.
SP_ANTHROPIC_API_KEY=

# Pipeline model spend caps in integer cents. Checked before every model call.
# Per user over the previous 30 days (default $10).
SP_MODEL_CAP_USER_CENTS=1000
# All users over the previous 24 hours (default $50).
SP_MODEL_CAP_DAY_CENTS=5000

# Alert email (failed deploys). Resend API key and the From address on a verified domain.
# Leave both empty and no mail is sent; alerts are recorded with error "not_configured".
RESEND_API_KEY=
SP_ALERT_FROM="Spooky Particles <alerts@spookyparticles.com>"
# Vercel Cron sends this as a bearer token to /api/cron/watch. Any long random string: openssl rand -base64 32
CRON_SECRET=

# Site-wide usage stats (GET /api/v1/stats) are for these accounts only, comma-separated emails. Empty means nobody.
SP_ADMIN_EMAILS=
