{
  "name": "@spooky/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && seolint",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "revoke:all": "node --env-file-if-exists=.env.local --import tsx scripts/mass-revoke.ts",
    "prebuild": "npm --prefix ../../packages/tier0 run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@neondatabase/serverless": "^1.2.0",
    "@spooky/tier0": "*",
    "@vercel/analytics": "^2.0.1",
    "better-auth": "^1.7.15",
    "drizzle-orm": "^0.45.4",
    "geist": "^1.9.0",
    "next": "16.4.3",
    "posthog-js": "^1.444.1",
    "posthog-node": "^5.61.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "workflow": "^5.2.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "seolint": "1.1.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
