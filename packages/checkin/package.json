{
  "name": "spooky-checkin",
  "version": "0.1.0",
  "description": "Automate fixes for Vercel cron and scheduled jobs: check in on each run, and a missed or failed run goes to your coding agent (Claude Code, Codex) through Spooky Particles. No dependencies.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://spookyparticles.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/banana-intelligence-dot-ai/spookyparticles.git",
    "directory": "packages/checkin"
  },
  "keywords": [
    "automate fixes",
    "vercel",
    "cron",
    "failed deploy",
    "coding agent",
    "claude code",
    "codex",
    "mcp",
    "monitoring",
    "heartbeat",
    "check-in",
    "scheduled-jobs"
  ],
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --experimental-strip-types --test \"test/*.test.ts\"",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/banana-intelligence-dot-ai/spookyparticles/issues"
  }
}
